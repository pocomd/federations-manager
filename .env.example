APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─────────────────────────────────────────────────────
# Application
# ─────────────────────────────────────────────────────

# Set to true by the installer after setup completes — do not edit manually
APP_INSTALLED=false

# Enable the Jagger (ResourceRegistry3) import UI at /import/jagger
JAGGER_IMPORT_ENABLED=false

# Enable multi-language UI switching (EN/RO and any lang/ files added)
I18N_ENABLED=false

# Enable the application health-status dashboard at /health-status (admin only)
HEALTH_UI_ENABLED=true

# Secret token for the machine-readable /health-status JSON endpoint; leave blank to disable token auth
HEALTH_CHECK_TOKEN=

# ─────────────────────────────────────────────────────
# XML signing
# ─────────────────────────────────────────────────────

# Full path to the xmlsectool binary used for XML signing
XMLSECTOOL_PATH=/usr/local/bin/xmlsectool

# Enable the local file signing driver (PEM key + cert stored on disk per federation)
FILE_SIGNING_IS_ACTIVE=true

# Enable the SoftHSM2 PKCS#11 signing driver (one hardware token per federation)
# Requires pkcs11-tool and softhsm2-util binaries and the settings below
SOFTHSM_SIGNING_IS_ACTIVE=false

# Path to the PKCS#11 shared library (e.g. SoftHSM2 or a real HSM vendor library)
PKCS11_LIBRARY=/usr/lib/softhsm/libsofthsm2.so

# Path to the SoftHSM2 configuration file
SOFTHSM2_CONF=/etc/softhsm/softhsm2.conf

# SoftHSM2 token user PIN — used by the app to sign metadata via xmlsectool
JAGGER_HSM_PIN=

# SoftHSM2 security officer (SO) PIN — used only during token initialisation
JAGGER_HSM_SO_PIN=

# ─────────────────────────────────────────────────────
# Federation defaults
# ─────────────────────────────────────────────────────

# Default mdrpi:RegistrationAuthority URI written into generated metadata
FEDERATION_REGISTRATION_AUTHORITY=

# ─────────────────────────────────────────────────────
# SimpleSAMLphp / SAML2
# ─────────────────────────────────────────────────────

# Set to true to show the institutional SSO (SAML2) login button on the login page
SAML_ENABLED=false

# This application's SAML2 SP entity ID
SAML2_SP_ENTITY_ID=https://registry.example.com/saml2/metadata

# Base URL path to the SimpleSAMLphp installation
SAML2_BASEURLPATH=/simplesaml/

# SimpleSAMLphp authentication source name
SAML2_AUTH_SOURCE=default-sp

# Identity Provider settings — required to enable SAML2 login
SAML2_IDP_ENTITY_ID=
SAML2_IDP_SSO_URL=
SAML2_IDP_SLS_URL=
SAML2_IDP_CERT=

# Optional: URL to fetch IdP metadata automatically; overrides the static cert above
SAML2_IDP_METADATA_URL=

# SAML2 attribute names mapped to user fields — defaults match common eduGAIN/REFEDS attributes
SAML2_ATTR_EPPN=eduPersonPrincipalName
SAML2_ATTR_DISPLAY_NAME=displayName
SAML2_ATTR_GIVEN_NAME=givenName
SAML2_ATTR_SURNAME=sn
SAML2_ATTR_MAIL=mail
